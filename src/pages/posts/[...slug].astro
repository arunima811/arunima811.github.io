---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts
    .filter((post) => !post.data.external)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const back = post.data.tab === 'work' ? '/#writing' : '/notwork/#writing';
---

<Base title={post.data.title} description={post.data.summary} tab={post.data.tab} image={post.data.image}>
  <article class="prose">
    <p class="meta"><a href={back}>← back</a></p>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'long')}</time>
      {post.data.draft && <span class="badge">draft</span>}
    </p>
    <Content />
  </article>
</Base>
