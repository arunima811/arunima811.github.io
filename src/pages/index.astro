---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Heatmap from '../components/Heatmap.astro';
import { profile } from '../data/profile';

const { work, timeline, sideProjects, recognition } = profile;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base tab="work" isTabHome>
  <Intro
    greeting={work.greeting}
    aka={work.aka}
    paragraphs={work.intro}
    photo={work.photo}
    now={work.now}
    links={work.links}
  />

  <section class="section" id="experience">
    <h2>experience</h2>
    <ol class="rows">
      {timeline.map((entry) => (
        <li>
          <div class="when">{entry.when}</div>
          <div class="what">
            <h3>{entry.role}</h3>
            <p class="sub">{entry.org} · {entry.where}</p>
            <ul>
              {entry.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="recognition">
    <h2>recognition</h2>
    <ul class="rows compact">
      {recognition.map((item) => (
        <li>
          <span class="when">{item.when}</span>
          <span class="what">{item.what}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="projects">
    <h2>projects</h2>
    <ul class="rows">
      {projects.map((project) => (
        <li>
          <div class="when">{project.data.period}</div>
          <div class="what">
            <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
            <p>{project.data.summary}</p>
            <div class="tags">{[project.data.org, ...project.data.stack].join(' · ')}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="side-projects">
    <h2>side projects</h2>
    <ul class="rows compact">
      {sideProjects.map((item) => (
        <li>
          <span class="when">{item.when}</span>
          <span class="what"><a href={item.href}>{item.title}</a> — {item.what}</span>
        </li>
      ))}
    </ul>
  </section>

  <Heatmap id="visit" title="visit" />
</Base>
