---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import PostList from '../components/PostList.astro';
import { profile } from '../data/profile';
import { getPosts } from '../lib/posts';

const { notwork } = profile;
const posts = await getPosts('notwork');
---

<Base tab="notwork" isTabHome title="!work">
  <Intro
    greeting={notwork.greeting}
    paragraphs={notwork.intro}
    photo={notwork.photo}
    tags={notwork.interests}
    links={notwork.links}
  />

  {posts.length > 0 && (
    <section class="section" id="writing">
      <h2>writing</h2>
      <PostList posts={posts} />
    </section>
  )}
</Base>
